{
  "buildCommand": "bash scripts/prepare-vercel.sh",
  "outputDirectory": "dist",
  "cleanUrls": false,
  "git": {
    "deploymentEnabled": {
      "*": false,
      "main": true,
      "cursor/godot-chinese-remake-5c3a": true
    }
  },
  "ignoreCommand": "bash scripts/vercel-ignore.sh",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Cross-Origin-Embedder-Policy",
          "value": "credentialless"
        },
        {
          "key": "Cross-Origin-Resource-Policy",
          "value": "cross-origin"
        }
      ]
    }
  ],
  "git": {
    "deploymentEnabled": {
      "*": false,
      "main": true,
      "cursor/godot-chinese-remake-5c3a": true
    }
  },
  "ignoreCommand": "bash scripts/vercel-ignore.sh"
}
