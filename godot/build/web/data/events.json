      { "id": "goodbye", "text": "道别", "next": "end" }
    ]
  },
  "noises_outside": {
    "title": "噪声",
    "notification": "古怪的声响透过墙壁传来",
    "when": { "location": "room", "wood_inited": true },
    "text": [
      "嘈杂声透墙传来。",
      "难以分辨来源。"
    ],
    "buttons": [
      { "id": "investigate", "text": "调查", "random_next": { "stuff": 0.3, "nothing": 0.7 } },
      { "id": "ignore", "text": "忽略", "next": "end" }
    ],
    "scenes": {
      "stuff": {
        "text": ["一捆用粗糙的皮毛扎起来的柴火斜倚在门槛上。", "黑夜重归静寂。"],
        "reward": { "wood": 100, "fur": 10 },
        "buttons": [{ "id": "back", "text": "回屋", "next": "end" }]
      },
      "nothing": {
        "text": ["模糊的身影掠过，消失在视野外。", "声响停止了。"],
        "buttons": [{ "id": "back", "text": "回屋", "next": "end" }]
      }
    }
  },
  "builder_finds_compass": {
    "title": "旧物",
    "notification": "建造者在小屋地基下摸到一块旧罗盘",
    "text": [
      "建造者在新竖起的小屋地基下摸到一块旧罗盘。",
      "这块旧罗盘破损蒙尘，但看起来还能用。"
    ],
    "buttons": [
      { "id": "take", "text": "收下", "reward": { "compass": 1 }, "next": "end" }
    ]
  },
  "ruined_trap": {
    "title": "损毁的陷阱",
    "notification": "一些陷阱损毁了",
    "when": { "location": "outside", "min_traps": 1 },
    "text": [
      "一些陷阱损毁了。",
      "巨大的足迹延伸至森林。"
    ],
    "buttons": [
      { "id": "track", "text": "追踪", "random_next": { "beast": 0.5, "gone": 0.5 } },
      { "id": "ignore", "text": "忽略", "next": "end" }
    ],
    "scenes": {
      "beast": {
        "text": ["村外不远处躺着一只巨兽，它的皮毛上染满了鲜血。", "它无力挣扎，任人宰割。"],
        "reward": { "fur": 100, "meat": 100 },
        "buttons": [{ "id": "home", "text": "返回", "next": "end" }]
      },
      "gone": {
        "text": ["数分钟后足迹消失了。", "森林归于静寂。"],
        "buttons": [{ "id": "home", "text": "返回", "next": "end" }]
      }
    }
  },
  "beast_attack": {
    "title": "野兽来袭",
    "notification": "野兽袭击村民",
    "when": { "location": "outside", "pop_gt": 0 },
    "text": [
      "一群咆哮的野兽冲出丛林。",
      "战斗争短暂而血腥，但兽群溃退了。",
      "村民撤了回来，悼念那些死去的人。"
    ],
    "buttons": [{ "id": "mourn", "text": "哀悼", "next": "end", "lose_pop": 1 }]
